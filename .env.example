# immich-steward configuration for docker compose.
# Copy this file to .env and adjust the values. Never commit .env.

# Version of the images pulled from ghcr.io. By default "0", the newest 0.x release: then
# `docker compose pull` alone updates the app. Set an exact version only to stay on it.
# STEWARD_VERSION=0.6.0

# Address of your Immich server as seen from this machine (LAN address, not localhost
# when Immich runs in another compose project).
STEWARD_IMMICH_URL=http://192.0.2.10:2283
# Address of Immich in your browser, for the "Open in Immich" links, if it differs from the
# one above (e.g. that one is a container name). Empty: the same as STEWARD_IMMICH_URL.
# STEWARD_IMMICH_PUBLIC_URL=https://photos.example.org

# Secret used to encrypt stored Immich API keys, at least 32 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later signs everybody out (stored keys can no longer be decrypted).
STEWARD_SECRET_KEY=

# Set to true if the UI is served over HTTPS (reverse proxy).
STEWARD_COOKIE_SECURE=false

# Port of the web UI on the host. Immich itself usually uses 2283.
STEWARD_PORT=8780

# Database credentials. Use letters and digits only in the password:
# it is embedded into a connection URL.
DB_USER=steward
DB_PASSWORD=change-me
DB_NAME=steward

# Base map style (MapLibre). The default OpenFreeMap needs no API key.
# STEWARD_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Map style for the dark theme of the web UI; empty (default): the map above, dimmed.
# STEWARD_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/fiord
# Address search (Photon). Leave empty to disable; a self-hosted Photon also works.
# STEWARD_GEOCODER_URL=https://photon.komoot.io

# Immich tag added to every location written by this app (it is not from the camera GPS).
# "a/b" creates a nested tag. Leave empty to write locations without a tag.
# STEWARD_ESTIMATED_TAG=steward/estimated

# Suggestions from photos taken close in time: how many hours before or after count.
# STEWARD_TIME_NEIGHBORS_WINDOW_HOURS=3

# Shared secret of the workers that run ML location modules (optional). Workers send it with
# every request; leave empty to turn the worker API off. Generate with: openssl rand -hex 32
STEWARD_WORKER_TOKEN=

# Modules that run automatically on photos without a location while a worker is connected
# (comma-separated); "similar" also on the photos with one, its search index. Empty: only when
# started from a photo card.
# STEWARD_AUTO_MODULES=geoclip,similar

# How GeoCLIP suggestions are shown, by their confidence (0..1): below the minimum they are hidden,
# below "weak" they are folded, from "confident" they are marked as such. Changing these needs
# no new runs.
# STEWARD_GEOCLIP_MIN_CONFIDENCE=0.25
# STEWARD_GEOCLIP_WEAK_BELOW=0.5
# STEWARD_GEOCLIP_CONFIDENT_FROM=0.75
# The same for similar photos, on their calibrated scale (0.2 ~ similarity 0.15, 0.8 ~ 0.35), and
# whether the photos whose location was set in this app are searched among too.
# STEWARD_SIMILAR_MIN_CONFIDENCE=0.2
# STEWARD_SIMILAR_WEAK_BELOW=0.5
# STEWARD_SIMILAR_CONFIDENT_FROM=0.8
# STEWARD_SIMILAR_INCLUDE_ESTIMATED=true

# Worker started with `docker compose --profile worker up -d` (GeoCLIP and similar photos on
# the CPU). Modules it runs, comma-separated; the first one's photos go first:
# STEWARD_WORKER_MODULES=similar,geoclip
# Keep one model in memory at a time (then 4g is enough for the limit below).
# STEWARD_WORKER_ONE_MODEL=false
# CPU threads it may use: keep it low next to Immich.
# STEWARD_WORKER_THREADS=2
# Do not take jobs while the 1-minute load average per CPU is above this (e.g. 0.8).
# STEWARD_WORKER_MAX_LOAD=
# Memory limit of the worker container: GeoCLIP needs about 3 GB at its peak, similar photos
# about 1.2 GB (2 GB while loading), and both may be loaded at once.
# STEWARD_WORKER_MEMORY_LIMIT=6g

# Log level: debug, info, warning, error.
STEWARD_LOG_LEVEL=info

# --- Development only (core running from a venv, see README) ---
# Database port on localhost, opened by compose.dev.yaml.
DB_PORT=5432
# Must match the DB_* values above.
STEWARD_DATABASE_URL=postgresql+asyncpg://steward:change-me@localhost:5432/steward
